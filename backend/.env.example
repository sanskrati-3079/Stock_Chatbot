# Copy to .env for local development. On Vercel/Render/Railway, set these
# in the dashboard's Environment Variables section instead. All are optional.
APP_NAME=Stock Prediction Chatbot API
DEFAULT_HISTORY_PERIOD=6mo      # 1d 5d 1mo 3mo 6mo 1y 2y 5y 10y ytd max
FORECAST_DAYS=5                 # 1-30
CORS_ORIGINS=*                  # in production: https://your-frontend.app,https://other.app
LOG_LEVEL=INFO
